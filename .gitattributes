# Vendored upstream files must stay byte-for-byte identical to their source.
data/upstream/** -text

# Shell scripts must keep LF line endings to run under bash.
*.sh text eol=lf

# Generated OSCAL is written with LF; keep the checkout byte-identical to generator output.
oscal/generated/** text eol=lf

# The rendered results page is written with LF; keep the checkout byte-identical to render output.
docs/results/** text eol=lf
